# OpenMapTiles v3.16 / openmaptiles-tools 7.2
# These credentials are local development defaults only. Do not expose PostgreSQL.
TILESET_FILE=openmaptiles.yaml
TOOLS_VERSION=7.2

PGDATABASE=openmaptiles
PGUSER=openmaptiles
PGPASSWORD=openmaptiles
PGHOST=postgres
PGPORT=5432

BBOX=-180.0,-85.0511,180.0,85.0511
MIN_ZOOM=0
MAX_ZOOM=7
DIFF_MODE=false
MBTILES_FILE=tiles.mbtiles
IMPOSM_CONFIG_FILE=/usr/src/app/config/repl_config.json
MAX_PARALLEL_PSQL=3
COPY_CONCURRENCY=3
PGHOSTS_LIST=
