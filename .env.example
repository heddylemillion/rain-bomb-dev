# Xweather API Credentials (NEVER commit .env or expose to frontend)
XWEATHER_CLIENT_ID=your_client_id_here
XWEATHER_CLIENT_SECRET=your_client_secret_here

# Optional namespace (leave empty for Xweather Free plan without namespace restriction)
XWEATHER_NAMESPACE=

# Base URL for Xweather API
XWEATHER_BASE_URL=https://data.api.xweather.com
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=RainBomb/0.1.0 (contact: your-email@example.com)
NOMINATIM_COUNTRYCODES=th
# Default false. When true, DATA_MODE=mock still calls Nominatim for reverse geocoding
# (street address of the selected point). Weather providers stay unreachable in mock mode.
GEOCODING_IN_MOCK=false

# Open-Meteo adapters: mock by default; live and cache modes are opt-in.
DATA_MODE=mock
OPEN_METEO_API_KEY=
OPEN_METEO_COMMERCIAL=false
VITE_BASE_TILE_URL=/api/map/tiles/{z}/{x}/{y}.png

# Backend Server Configuration
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Comma-separated CORS origins allowed to call the backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Observations use a five-minute cache by default.
WEATHER_CACHE_TTL_SECONDS=300

# Default false. Enables an explicit persistent demo-mode banner only.
DEMO_MODE=false
