# Xweather API Credentials (NEVER commit .env or expose to frontend)
XWEATHER_CLIENT_ID=your_client_id_here
XWEATHER_CLIENT_SECRET=your_client_secret_here

# Optional namespace (leave empty for Xweather Free plan without namespace restriction)
XWEATHER_NAMESPACE=

# Base URL for Xweather API
XWEATHER_BASE_URL=https://data.api.xweather.com

# Backend Server Configuration
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Comma-separated CORS origins allowed to call the backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Weather Cache TTL in seconds (default 600 = 10 minutes)
WEATHER_CACHE_TTL_SECONDS=600

# Allow mock fallback when Xweather API fails and no stale cache exists (true/false)
# Note: Any mock fallback is strictly flagged with isMock: true and labelled "ข้อมูลจำลอง"
ALLOW_MOCK_FALLBACK=true
