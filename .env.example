# Nominatim geocoding (the service URL is fixed in backend code)
NOMINATIM_USER_AGENT=RainBomb/0.1.0 (community weather dashboard)
NOMINATIM_COUNTRYCODES=th

# Providers default to live mode inherited from DATA_MODE (live or cache).
DATA_MODE=live
RADAR_PROVIDER=rainviewer
# RADAR_MODE=live|cache
LIGHTNING_PROVIDER=none
# LIGHTNING_MODE=live|cache
STORM_TRACK_PROVIDER=gdacs
# STORM_TRACK_MODE=live|cache

# The assistant is disabled unless explicitly enabled.
CHAT_PROVIDER=none
# CHAT_PROVIDER=openrouter
# OPENROUTER_API_KEY=your_api_key
# OPENROUTER_MODEL=your_selected_model
# OPENROUTER_FALLBACK_MODELS=provider/backup-model,provider/another-model
CHAT_DAILY_BUDGET_REQUESTS=0
CHAT_HTTP_REFERER=http://localhost:5173
CHAT_X_TITLE=Rain Burst
REQUIRE_APPROVED_ADVISORIES=true

# Backend server settings
PORT=3001
NODE_ENV=development
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
WEATHER_CACHE_TTL_SECONDS=300
STORM_CONE_KM_PER_30MIN=2.5

# OpenFreeMap Liberty is the default. Use selfhosted to opt in to local tiles.
VITE_BASEMAP_PROVIDER=openfreemap
VITE_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# VITE_BASEMAP_PROVIDER=selfhosted
# VITE_BASEMAP_STYLE_URL=http://localhost:8080/styles/thailand/style.json
